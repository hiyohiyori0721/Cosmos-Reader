{
  "name": "Cosmos-Reader",
  "short_name": "阅读器",
  "description": "功能完整、开箱即用的纯前端电子书阅读器，支持 EPUB / TXT / PDF / ZIP，数据保存在本地，离线可用。",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#f7f5f0",
  "theme_color": "#b8860b",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" }
  ]
}
