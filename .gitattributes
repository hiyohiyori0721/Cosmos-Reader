# 统一换行符与编码，避免 Windows 与 macOS/Linux 混用问题
* text=auto

*.js    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.xml   text eol=lf
*.gradle text eol=lf
*.java  text eol=lf
*.properties text eol=lf

*.png   binary
*.jpg   binary
*.apk   binary
*.epub  binary
*.pdf   binary
*.zip   binary
*.ttf   binary
*.woff  binary
